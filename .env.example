# SynthID-Image-Eval Environment Variables
# Copy this file to .env and fill in your actual values

# Google Cloud Configuration (Required for SynthID watermark detection via Vertex AI)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-credentials.json

# API Keys (Required for image generation via Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here

# Model Configuration
IMAGE_GENERATION_MODEL=gemini-3-pro-image-preview
# Note: SynthID detection uses Vertex AI WatermarkVerificationModel (imageverification@001)
# No separate detection model configuration needed
